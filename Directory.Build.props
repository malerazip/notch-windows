<Project>
  <!-- bin/obj ficam fora do OneDrive para não sincronizar arquivos temporários de compilação -->
  <PropertyGroup>
    <NotchBuildRoot>$(LOCALAPPDATA)\ProjetoNotch-build\</NotchBuildRoot>
    <BaseIntermediateOutputPath>$(NotchBuildRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(NotchBuildRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Company>Alexandre</Company>
    <Product>Projeto Notch</Product>
  </PropertyGroup>
</Project>
